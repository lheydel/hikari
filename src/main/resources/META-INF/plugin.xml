<idea-plugin>
    <id>dev.kosmio.hikari</id>
    <name>hikari</name>
    <vendor>kosmio</vendor>
    <description><![CDATA[Adds tools to the IDE's built-in MCP server. Exposes IntelliJ local changelists: read state, draft commit messages from a changelist diff, and organize modified files into changelists. Adds code intelligence the MCP server does not otherwise offer: a reverse call tree that walks from a declaration to what transitively calls it, following what it overrides so an implementation reaches its port's callers, and a file outline that lists a file's declarations with their signatures and line ranges so only the relevant part need be read. In the Git tool window's Worktrees tab, adds Merge and Remove: merges a finished worktree into the current branch, then removes the worktree and its branch. On 2026.2, a linked worktree opened in the IDE receives the gitignored files its .worktreeinclude lists, as claude -w does. Every surface a program can reach, the MCP tools included, reads and organizes only: none mutates file contents or VCS state, scheduling unversioned files for addition being the single exception.]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>com.intellij.mcpServer</depends>
    <depends>Git4Idea</depends>

    <!-- The Kotlin override hop and local folding. Optional so an IDE without the Kotlin plugin still loads
         this plugin and every tool in it; call_tree reports the hop unavailable for Kotlin rather than
         failing. -->
    <depends optional="true" config-file="hikari-kotlin.xml">org.jetbrains.kotlin</depends>

    <!-- Declared HERE, not in the config file above: the loader reads
         org.jetbrains.kotlin.supportsKotlinPluginMode off the ROOT descriptor to decide whether to load
         that config file at all (KotlinK2ModeCompatibilityCheckerKt.getSupportKotlinPluginModeEPs). Put
         it inside the file it gates and the file is silently skipped in K2 mode — the override hop then
         reports itself unavailable, with no indication why. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <!-- toLightMethods resolves through the Analysis API in K2 mode; nothing here needs K1. -->
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensionPoints>
        <!-- "What does this declaration override" and "is this declaration local" have no language-neutral
             platform API, so they are the surface of the traversal contributed per language, from an
             optional config file. -->
        <extensionPoint name="callTreeLanguageSupport"
                        interface="dev.kosmio.hikari.analysis.CallTreeLanguageSupport"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij.mcpServer">
        <mcpToolset implementation="dev.kosmio.hikari.changelist.HikariChangelistToolset"/>
        <mcpToolset implementation="dev.kosmio.hikari.analysis.HikariAnalysisToolset"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="hikari.worktree" displayType="BALLOON"/>
        <postStartupActivity implementation="dev.kosmio.hikari.worktree.WorktreeIncludeActivity"/>
    </extensions>

    <actions>
        <action id="Hikari.WorkingTrees.MergeAndRemove"
                class="dev.kosmio.hikari.worktree.MergeAndRemoveWorktreeAction"
                text="Merge and Remove"
                description="Merge the selected worktree into this window's branch, then remove the worktree and its branch"
                icon="AllIcons.Vcs.Merge">
            <add-to-group group-id="Git.WorkingTrees.ToolwindowGroup.Toolbar" anchor="before" relative-to-action="Git.WorkingTrees.Remove"/>
            <add-to-group group-id="Git.WorkingTrees.ToolwindowGroup.Popup" anchor="before" relative-to-action="Git.WorkingTrees.Remove"/>
        </action>
    </actions>
</idea-plugin>
